# Supabase credentials for the InsightFlow web app (server-side only).
# Copy to .env.local and fill in. Never commit .env.local.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: used for server reads when no service-role key is set.
SUPABASE_ANON_KEY=
# Optional: general LLM config for classifying new submissions (server-side
# only). Any OpenAI-compatible chat API works; heuristic fallback when absent.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
